# No archive API key, NASA API key, IRSA password, or AWS account is required.
# Set these in your shell; .env is documentation only and is not loaded automatically.
SPHEREX_DATA_DIR=./data
SPHEREX_TIMEOUT_SECONDS=120
SPHEREX_CACHE_BUDGET_MB=2048
# Comma-separated explicit origins, once a separate frontend exists:
# SPHEREX_CORS_ORIGINS=http://localhost:3000
